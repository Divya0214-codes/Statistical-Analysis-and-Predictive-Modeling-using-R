library(palmerpenguins)
library(tidyverse)
library(caret)
library(car)
library(lmtest)
library(ggplot2)

#import the dataset
data("penguins")

head(penguins)
View(penguins)

#understand the dataset
dim(penguins)

str(penguins)

summary(penguins)

colnames(penguins)

# data cleaning and preprocessing
#checking missing value
colSums(is.na(penguins))
#check duplicate
sum(duplicated(penguins))
#duplicate records
sum(duplicated(penguins))
# select the required columns
penguins_model <- penguins %>%
  select(
    species,
    island,
    bill_length_mm,
    bill_depth_mm,
    flipper_length_mm,
    body_mass_g,
    sex
  )

# Removing missing values
penguins_clean <- penguins_model %>%
  drop_na()

#verify cleaned data
dim(penguins_clean)

colSums(is.na(penguins_clean))

summary(penguins_clean)

# convert categorical columns into factors
penguins_clean <- penguins_clean %>%
  mutate(
    species = as.factor(species),
    island = as.factor(island),
    sex = as.factor(sex)
  )


# Exploratory Statistical Analysis (EDA)

# statistical summary
summary(penguins_clean)

# calculate mean, median and standard deviation

penguins_clean %>%
  summarise(
    Mean_Mass = mean(body_mass_g),
    Median_Mass = median(body_mass_g),
    SD_Mass = sd(body_mass_g),
    Min_Mass = min(body_mass_g),
    Max_Mass = max(body_mass_g)
  )

# species wise statistical summary
penguins_clean %>%
  group_by(species) %>%
  summarise(
    Total = n(),
    Average_Mass = mean(body_mass_g),
    Median_Mass = median(body_mass_g),
    Average_Flipper = mean(flipper_length_mm),
    .groups = "drop"
  )

# create histogram

ggplot(penguins_clean,
       aes(x = body_mass_g)) +
  geom_histogram(
    bins = 20,
    fill = "navy",
    color = "black"
  ) +
  labs(
    title = "Distribution of Penguin Body Mass",
    x = "Body Mass (grams)",
    y = "Frequency"
  ) +
  theme_minimal()

# box plot
ggplot(penguins_clean,
       aes(x = species,
           y = body_mass_g,
           fill = species)) +
  geom_boxplot() +
  labs(
    title = "Body Mass Comparison by Species",
    x = "Species",
    y = "Body Mass (grams)"
  ) +
  theme_minimal()

# scatter plot

ggplot(penguins_clean,
       aes(x = flipper_length_mm,
           y = body_mass_g,
           color = species)) +
  geom_point() +
  geom_smooth(method = "lm",
              se = FALSE) +
  labs(
    title = "Flipper Length vs Body Mass",
    x = "Flipper Length (mm)",
    y = "Body Mass (grams)"
  ) +
  theme_minimal()

# Hypothesis testing

anova_model <- aov(
  body_mass_g ~ species,
  data = penguins_clean
)

summary(anova_model)


TukeyHSD(anova_model)

# Pearson Correlation tes

cor.test(
  penguins_clean$flipper_length_mm,
  penguins_clean$body_mass_g,
  method = "pearson"
)

# check statistical assumptions

numeric_data <- penguins_clean %>%
  select(
    bill_length_mm,
    bill_depth_mm,
    flipper_length_mm,
    body_mass_g
  )

cor(numeric_data)

# check normality
shapiro.test(
  residuals(anova_model)
)

# check equal variance for anova

# visualization the relationship

plot(
  penguins_clean$flipper_length_mm,
  penguins_clean$body_mass_g,
  main = "Linearity Check",
  xlab = "Flipper Length",
  ylab = "Body Mass"
)

# split the data set into training and testing data

set.seed(123)

train_index <- createDataPartition(
  penguins_clean$body_mass_g,
  p = 0.80,
  list = FALSE
)

train_data <- penguins_clean[
  train_index, ]

test_data <- penguins_clean[
  -train_index, ]

dim(train_data)

dim(test_data)


# build a mutiple linear regression model

model <- lm(
  body_mass_g ~
    flipper_length_mm +
    bill_length_mm +
    bill_depth_mm +
    species +
    sex +
    island,
  data = train_data
)

summary(model)


# apply 5 fold cross validation

set.seed(123)

control <- trainControl(
  method = "cv",
  number = 5
)

cv_model <- train(
  body_mass_g ~
    flipper_length_mm +
    bill_length_mm +
    bill_depth_mm +
    species +
    sex +
    island,
  data = train_data,
  method = "lm",
  trControl = control,
  metric = "RMSE"
)

# predict body mass using the test dataset 

predictions <- predict(
  model,
  newdata = test_data
)

head(predictions)

# compare actual and predicted body mass

comparison <- data.frame(
  Actual = test_data$body_mass_g,
  Predicted = predictions
)

head(comparison, 10)

ggplot(
  comparison,
  aes(x = Actual, y = Predicted)
) +
  geom_point(color = "blue") +
  geom_abline(
    intercept = 0,
    slope = 1,
    color = "red"
  ) +
  labs(
    title = "Actual vs Predicted Body Mass",
    x = "Actual Body Mass (grams)",
    y = "Predicted Body Mass (grams)"
  ) +
  theme_minimal()

print(cv_model)

# evaluate model performance

performance <- postResample(
  pred = predictions,
  obs = test_data$body_mass_g
)

print(performance)

# Model diagnostic analysis

par(mfrow = c(2, 2))

plot(model)

par(mfrow = c(1, 1))


# check multicollinearity

car::vif(model)

# check heteroscedasticity
library(lmtest)
packageVersion("lmtest")

lmtest::bptest(model)

# improve the model

model2 <- lm(
  body_mass_g ~
    flipper_length_mm +
    species +
    sex +
    bill_length_mm +
    bill_depth_mm,
  data = train_data
)

summary(model2)
